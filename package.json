{
  "name": "solidity-proof",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Reference Solidity contracts with Hardhat and Foundry tests, upgradeability, gas analysis and static analysis.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "REPORT_GAS=true hardhat test",
    "test:foundry": "forge test",
    "slither": "slither . --compile-force-framework hardhat --hardhat-ignore-compile --filter-paths \"node_modules|contracts/test\" --exclude-dependencies",
    "e2e": "scripts/e2e.sh",
    "mythril": "scripts/mythril.sh"
  },
  "keywords": [],
  "author": "Gregory J. Ward",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "ethers": "6.17.0",
    "hardhat": "2.30.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "tmp": "^0.2.7",
    "cookie": "^0.7.2",
    "serialize-javascript": "^7.1.4",
    "@ethersproject/providers": {
      "ws": "^8.21.0"
    },
    "ethjs-unit": {
      "bn.js": "^4.12.3"
    },
    "number-to-bn": {
      "bn.js": "^4.12.3"
    }
  }
}
